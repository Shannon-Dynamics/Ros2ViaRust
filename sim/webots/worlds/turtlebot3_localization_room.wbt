#VRML_SIM R2025a utf8
# ROS via Rust, Phase 3 (localization): an empty 6 x 6 m room with four static
# cylindrical landmarks at known coordinates. No furniture, no clutter, no corridors:
# the scenario isolates pose estimation from mapping and SLAM.
#
# Size follows the sensor: the LDS-01 reports range_max = 3.5 m, so a 6 x 6 m room keeps
# at least one wall inside the lidar range from every point in it, including the centre
# (3.0 m to each wall). The landmarks sit asymmetrically, which breaks the four-fold
# rotational symmetry a bare square room would have and makes global localization
# solvable instead of ambiguous.
#
# The robot is the official TurtleBot3Burger proto with controller "<extern>", so the
# webots_ros2_turtlebot driver (Python/C++, used unchanged) attaches to it and publishes
# /scan, /odom, /imu and /joint_states. The extensionSlot repeats the device set the
# official example world uses, because the driver URDF refers to those devices by name:
# "inertial_unit" (InertialUnit), "gyro" and "accelerometer" (inside the proto), and the
# LDS-01 lidar.
#
# The robot carries DEF TURTLEBOT3 so that ../scripts/evaluation_supervisor.py can read its
# true pose out of the scene tree and teleport it for the kidnapped robot experiment.
#
# The Ros2Supervisor robot below is the one the official stack normally injects into a
# temporary copy of the world; it is written out explicitly because the launch file starts
# Webots directly (see ../launch/localization_world.launch.py). The movie_recorder robot
# next to it has no devices and is only there so that ../scripts/movie_recorder.py can
# attach as an extern supervisor and record the 3D view, and evaluation_supervisor is the
# one ../scripts/evaluation_supervisor.py attaches to for ground truth and teleporting.
#
# Both carry synchronization FALSE, and that is not cosmetic: Webots blocks the simulation
# while a *synchronized* extern controller has not connected yet, so a world holding an
# auxiliary robot that this particular run does not start would never step at all. With
# synchronization FALSE the simulation runs whether or not they are connected, and the
# robot they watch is unaffected either way.
#
# Landmark ground truth is duplicated in ../config/landmarks.yaml; keep both in sync.

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/robotis/turtlebot/protos/TurtleBot3Burger.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/robotis/protos/RobotisLds01.proto"

WorldInfo {
  info [
    "ROS via Rust, Phase 3 localization world."
    "Empty room, four static landmarks, TurtleBot3 Burger driven by webots_ros2_turtlebot."
  ]
  title "TurtleBot3 localization room"
  basicTimeStep 20
}
Viewpoint {
  orientation -0.385551 0.385551 0.838273 1.746300
  position 4.5 -5.5 9.0
}
TexturedBackground {
  texture "empty_office"
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 6 6
  floorTileSize 1 1
  wallThickness 0.05
  wallHeight 0.5
}
DEF TURTLEBOT3 TurtleBot3Burger {
  translation 0 0 0
  rotation 0 0 1 0
  controller "<extern>"
  extensionSlot [
    Solid {
      name "imu_link"
    }
    InertialUnit {
      name "inertial_unit"
    }
    RobotisLds01 {
    }
  ]
}
Robot {
  name "Ros2Supervisor"
  controller "<extern>"
  supervisor TRUE
}
Robot {
  name "movie_recorder"
  controller "<extern>"
  supervisor TRUE
  synchronization FALSE
}
Robot {
  name "evaluation_supervisor"
  controller "<extern>"
  supervisor TRUE
  synchronization FALSE
}
DEF LANDMARK_A Solid {
  translation 1.8 1.2 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.2 0.2
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.6
        radius 0.15
      }
    }
  ]
  name "landmark_a"
  boundingObject Cylinder {
    height 0.6
    radius 0.15
  }
}
DEF LANDMARK_B Solid {
  translation -1.4 2.0 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.7 0.3
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.6
        radius 0.15
      }
    }
  ]
  name "landmark_b"
  boundingObject Cylinder {
    height 0.6
    radius 0.15
  }
}
DEF LANDMARK_C Solid {
  translation -2.0 -1.0 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.4 0.9
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.6
        radius 0.15
      }
    }
  ]
  name "landmark_c"
  boundingObject Cylinder {
    height 0.6
    radius 0.15
  }
}
DEF LANDMARK_D Solid {
  translation 0.9 -2.1 0.3
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.7 0.1
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.6
        radius 0.15
      }
    }
  ]
  name "landmark_d"
  boundingObject Cylinder {
    height 0.6
    radius 0.15
  }
}
