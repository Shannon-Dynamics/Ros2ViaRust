<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotics_sim_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter for the deterministic Rusty simulator (joint_states, imu/data, scan, ground truth, static sensor TF) and an estimator accuracy evaluator.</description>
  <maintainer email="russell.otniel@shannon.id">Shannon Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>robotics_ros_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
