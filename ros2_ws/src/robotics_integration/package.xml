<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotics_integration</name>
  <version>0.1.0</version>
  <description>Rust-first integration tests for the ros2-rust-robotics stack: spawn a launch file, verify the ROS graph (nodes, topics, QoS, rates, TF), shut it down with SIGINT and verify a clean exit.</description>
  <maintainer email="russell.otniel@shannon.id">Shannon Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclrs</depend>
  <depend>robotics_ros_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <exec_depend>robotics_bringup</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
